# LLNet unified Compose: copy to .env and set strong values.
# DO NOT commit .env or paste actual secrets into tickets/chats.
# COMPOSE_FILE is intentionally absent: compose.yaml is auto-discovered.
POSTGRES_USER=llnet
POSTGRES_DB=llnet
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
AIRFLOW_DB_PASSWORD=CHANGE_ME_STRONG_AIRFLOW_DB_PASSWORD
AIRFLOW_LAB_PASSWORD=CHANGE_ME_STRONG_AIRFLOW_LOGIN_PASSWORD
AIRFLOW_JWT_SECRET=CHANGE_ME_RANDOM_64_HEX
LLNET_INTERNAL_TOKEN=CHANGE_ME_RANDOM_64_HEX
LLNET_AUTO_HEAL=false
